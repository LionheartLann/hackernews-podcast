# ============================================================
# SuperTechFans Daily Podcast - Configuration
# Copy to .env and fill in your values: cp .env.example .env
# ============================================================

# --- LLM (for script generation) ---
# Optional: set for faster/cheaper direct API calls
# If not set, falls back to openclaw agent CLI
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
LLM_MODEL=google/gemini-2.5-flash-preview

# --- TTS (voice synthesis) ---
# Free Microsoft Edge TTS, no API key needed
TTS_VOICE=zh-CN-YunxiNeural
TTS_RATE=-5%

# --- Cloudflare R2 (MP3 storage) ---
# Get these from: Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=hackernews-podcast
# Public URL for the R2 bucket (after enabling public access or custom domain)
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# --- GitHub Pages (RSS hosting) ---
# Format: username/repo-name
GITHUB_PAGES_REPO=your-username/hackernews-podcast

# --- Podcast metadata ---
PODCAST_TITLE=超级科技迷·八分日报
PODCAST_DESCRIPTION=每天8分钟，用梁文道《八分》的风格聊聊 HackerNews 上最有意思的科技文化话题。AI 生成，人文视角。
PODCAST_AUTHOR=SuperTechFans
PODCAST_LANGUAGE=zh-cn
PODCAST_IMAGE_URL=https://supertechfans.com/favicon.png
PODCAST_WEBSITE=https://supertechfans.com/cn/
